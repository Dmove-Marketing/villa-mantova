---
// ============================================================================
// PÁGINA DESATIVADA — réplica de villamantova.com.br/corporativo/
// ----------------------------------------------------------------------------
// O prefixo "_" no nome do arquivo faz o Astro ignorar esta página: ela NÃO é publicada
// e fica guardada para uso futuro. Para ativar, renomeie sem o "_":
//     git mv src/pages/_corporativo-original.astro src/pages/corporativo-original.astro
// (a URL passa a ser /corporativo-original). Antes de ativar, considere:
//   - Formulários: o JS original monta uma mensagem e abre o WhatsApp 5511981001030 (número do site
//     original; o do projeto ainda está pendente). Para enviar ao n8n, ligar ao padrão Dmove (forms.ts).
//   - noIndex está ligado para não duplicar o conteúdo do site no ar; remova se esta virar a oficial.
// Imagens e vídeo já estão no CDN: photos/corporativo/ e videos/equipe.mp4.
// ============================================================================
import Base from '../layouts/Base.astro';
import '../styles/corporativo-original.css';

const title = "Villa Mantova Corporativo · Eventos Corporativos Premium em Alphaville";
const description = "Espaço premium para eventos corporativos a 20 minutos de Alphaville. Estrutura validada de 3.750m² para workshops, congressos, convenções e treinamentos.";
const hero = 'https://media.dmove.com.br/clients/villa-mantova/photos/corporativo/hero-principal.webp';
---

<Base title={title} description={description} ogImage={hero} theme="light" hideWhatsApp={true} noIndex={true}>
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&amp;family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet" slot="head" />
  <link rel="preload" as="image" href={hero} fetchpriority="high" slot="head" />

<div id="inicio" style="position:absolute; top:0; left:0; width:1px; height:1px; pointer-events:none;"></div>

  <!-- ==========================================================================
       1. TARJA SUPERIOR (TOP BAR)
       ========================================================================== -->
  <div id="top-bar">
    <div class="top-bar-inner">
      <div class="top-bar-text">
        <svg class="icon icon-sm top-bar-icon" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>PARA EVENTOS CORPORATIVOS PREMIUM, ESPAÇO ÚNICO 3.750M², MULTI-AMBIENTE COM NATUREZA INCLUSA</span>
      </div>
    </div>
  </div>

  <!-- ==========================================================================
       2. MENU FIXO / STICKY HEADER
       ========================================================================== -->
  <header id="main-header">
    <div class="container header-container">
      <!-- Logotipo da Marca -->
      <a href="#inicio" class="brand-logo" aria-label="Villa Mantova Corporativo">
        <img src="https://media.dmove.com.br/clients/villa-mantova/photos/corporativo/villa-mantova-corp-logo-transp.png" alt="Villa Mantova Corporativo" class="brand-logo-img">
      </a>

      <!-- Navegação Desktop -->
      <nav class="desktop-nav" aria-label="Navegação Principal">
        <a href="#inicio" class="nav-link">Início</a>
        <a href="#o-espaco" class="nav-link">O Espaço</a>
        <a href="#formatos" class="nav-link">Formatos de Evento</a>
        <a href="#por-que-villa-mantova" class="nav-link">Por que Villa Mantova</a>
        <a href="#galeria" class="nav-link">Galeria</a>
        <a href="#depoimentos" class="nav-link">Depoimentos</a>
        <a href="#faq" class="nav-link">FAQ</a>
        <a href="#rodape" class="nav-link">Contato</a>
      </nav>

      <!-- Ações do Cabeçalho & Redes -->
      <div class="header-actions">
        <a href="https://instagram.com/villamantova.eventos" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Instagram Villa Mantova" title="@villamantova.eventos">
          <svg class="icon icon-sm" viewBox="0 0 24 24"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <button type="button" class="btn btn-primary btn-sm" data-open-modal>
          <svg class="icon icon-sm" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span>Solicitar Orçamento</span>
        </button>
      </div>

      <!-- Gatilho do Menu Mobile -->
      <div class="mobile-nav-toggle">
        <button type="button" class="mobile-cta-sm" data-open-modal>Orçamento</button>
        <button type="button" id="menu-toggle-btn" class="menu-btn" aria-label="Alternar menu">
          <svg class="icon" viewBox="0 0 24 24"><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
        </button>
      </div>
    </div>

    <!-- Drawer Mobile -->
    <div id="mobile-drawer" class="mobile-drawer">
      <div class="mobile-drawer-links">
        <a href="#inicio" class="mobile-nav-link">Início</a>
        <a href="#o-espaco" class="mobile-nav-link">O Espaço</a>
        <a href="#formatos" class="mobile-nav-link">Formatos de Evento</a>
        <a href="#por-que-villa-mantova" class="mobile-nav-link">Por que Villa Mantova</a>
        <a href="#galeria" class="mobile-nav-link">Galeria</a>
        <a href="#depoimentos" class="mobile-nav-link">Depoimentos</a>
        <a href="#faq" class="mobile-nav-link">FAQ</a>
        <a href="#rodape" class="mobile-nav-link">Contato</a>
      </div>
      <div class="mobile-drawer-actions">
        <a href="https://instagram.com/villamantova.eventos" target="_blank" rel="noopener noreferrer" class="mobile-nav-link" style="display:flex; align-items:center; gap:0.5rem;">
          <svg class="icon icon-sm" viewBox="0 0 24 24"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          <span>@villamantova.eventos</span>
        </a>
        <button type="button" class="btn btn-primary btn-block" data-open-modal>Solicitar Orçamento</button>
      </div>
    </div>
  </header>

  <main>
    <!-- ==========================================================================
         3. HERO SECTION
         ========================================================================== -->
    <section id="hero">
      <div class="hero-bg-wrapper">
        <img src="https://media.dmove.com.br/clients/villa-mantova/photos/corporativo/hero-principal.webp" alt="Villa Mantova Espaço Corporativo em Santana de Parnaíba" class="hero-bg-img">
        <div class="hero-gradient-overlay"></div>
        <div class="hero-vignette-overlay"></div>
      </div>

      <div class="container hero-content">
        <div class="pill-badge">
          <span class="pulsing-dot"></span>
          <span>Espaço para eventos corporativos · Alphaville</span>
        </div>

        <h1 class="hero-headline">
          Evento premium não se improvisa. Se realiza em estrutura validada.
        </h1>

        <p class="hero-subpromise">
          3.750m² a 20 minutos de Alphaville, com ambientes independentes para sessões simultâneas, espaços de descompressão totalmente equipados<br>e mais de 500 eventos de lastro.
        </p>

        <p class="hero-pain">
          Sem coordenar cinco fornecedores. Sem encolher a programação para caber no espaço.
        </p>

        <div class="hero-ctas">
          <button type="button" class="btn btn-primary" data-open-modal>
            <span>Solicitar proposta corporativa</span>
            <svg class="icon icon-sm" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
          <a href="#galeria" class="btn btn-outline-light">
            <svg class="icon icon-sm" viewBox="0 0 24 24" style="stroke: #c3935b;"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
            <span>Conhecer as instalações</span>
          </a>
        </div>

        <div class="hero-data-bar">
          20 min de Alphaville · Até 300 pessoas · 3.750m² de área total
        </div>
      </div>

      <a href="#autoridade" class="hero-scroll-btn" aria-label="Rolar para baixo">
        <svg class="icon" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
      </a>
    </section>

    <!-- ==========================================================================
         4. FAIXA DE AUTORIDADE
         ========================================================================== -->
    <section id="autoridade">
      <div class="container">
        <div class="metrics-grid">
          <div class="metric-item">
            <div class="metric-value">500+</div>
            <div class="metric-label">Eventos realizados</div>
          </div>
          <div class="metric-item">
            <div class="metric-value">3.750m²</div>
            <div class="metric-label">De área total</div>
          </div>
          <div class="metric-item">
            <div class="metric-value">300</div>
            <div class="metric-label">Pessoas de capacidade</div>
          </div>
          <div class="metric-item">
            <div class="metric-value">4,9★</div>
            <div class="metric-label">Avaliação no Google</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================================================
         5. O PROBLEMA (TENSÃO)
         ========================================================================== -->
    <section id="o-problema" class="section">
      <div class="container-medium">
        <div class="section-header">
          <span class="section-tag section-tag-dark">O Desafio da Produção</span>
          <h2 class="section-title">A programação sempre nasce maior do que o espaço permite</h2>
        </div>

        <div class="problem-grid">
          <div class="problem-card">
            <div class="problem-icon-wrapper">
              <svg class="icon" viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
            </div>
            <p class="problem-card-text">Duas trilhas de conteúdo viram uma, porque só existe um auditório.</p>
          </div>

          <div class="problem-card">
            <div class="problem-icon-wrapper">
              <svg class="icon" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <p class="problem-card-text">O intervalo encolhe, porque não tem onde as pessoas ficarem além do corredor.</p>
          </div>

          <div class="problem-card">
            <div class="problem-icon-wrapper">
              <svg class="icon" viewBox="0 0 24 24"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
            </div>
            <p class="problem-card-text">Som vem de um fornecedor. Projeção de outro. Catering de um terceiro.</p>
          </div>

          <div class="problem-card">
            <div class="problem-icon-wrapper">
              <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <p class="problem-card-text">E alguém do seu time passa o dia do evento coordenando fornecedor em vez de participar dele.</p>
          </div>
        </div>

        <div class="climax-callout">
          <p class="climax-text">“Não é o evento que estava grande demais. É o espaço que não foi feito para ele.”</p>
        </div>
      </div>
    </section>

    <!-- ==========================================================================
         6. A VIRADA (POSICIONAMENTO)
         ========================================================================== -->
    <section id="a-virada" class="section">
      <div class="container">
        <div class="turnaround-grid">
          <!-- Imagem com Selo -->
          <div class="turnaround-image-container">
            <img loading="lazy" decoding="async" src="https://media.dmove.com.br/clients/villa-mantova/photos/corporativo/posicionamento-operacao.webp" alt="Estrutura e operação validada no Villa Mantova" class="turnaround-img">
            <div class="turnaround-stamp">
              <div class="stamp-icon-box">
                <svg class="icon icon-lg" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              </div>
              <div>
                <h4 class="stamp-title">Operação Blindada Contra Falhas</h4>
                <p class="stamp-desc">Planejamento técnico testado em mais de 500 execuções reais.</p>
              </div>
            </div>
          </div>

          <!-- Conteúdo em Texto -->
          <div class="turnaround-text-content">
            <div>
              <span class="section-tag section-tag-dark">Posicionamento & Lastro</span>
              <h2 class="section-title">Mais de 500 eventos construíram essa operação</h2>
            </div>

            <div class="turnaround-paragraphs">
              <p>O Villa Mantova não começou no corporativo. Começou em um formato que não admite falha — onde não existe "a gente ajusta na próxima" e o imprevisto precisa ser resolvido em minutos, não em reunião.</p>
              <p>Foram mais de 500 eventos aprendendo som, projeção, fluxo de pessoas, clima, mudança de última hora.</p>
              <p>É essa mesma estrutura que hoje recebe empresas.</p>
            </div>

            <div class="highlight-quote-card">
              <p class="highlight-quote-text">“Para fazer evento premium, não basta o espaço ser bonito. Ele precisa ter sido testado.”</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================================================
         7. O ESPAÇO (EXPERIÊNCIA)
         ========================================================================== -->
    <section id="o-espaco" class="section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Experiência</span>
          <h2 class="section-title">O Espaço</h2>
        </div>

        <div class="space-grid">
          <div class="space-card">
            <div>
              <div class="space-icon-box">
                <svg class="icon icon-lg" viewBox="0 0 24 24"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
              </div>
              <h3 class="space-card-title">Ambientes independentes</h3>
              <p class="space-card-desc">Palestra numa sala, workshop na outra — ao mesmo tempo, sem improviso de divisória</p>
            </div>
          </div>

          <div class="space-card">
            <div>
              <div class="space-icon-box">
                <svg class="icon icon-lg" viewBox="0 0 24 24"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
              </div>
              <h3 class="space-card-title">Áreas cobertas e ao ar livre</h3>
              <p class="space-card-desc">3.750m² que mudam de configuração conforme a programação define</p>
            </div>
          </div>

          <div class="space-card">
            <div>
              <div class="space-icon-box">
                <svg class="icon icon-lg" viewBox="0 0 24 24"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
              </div>
              <h3 class="space-card-title">Espaços de descompressão equipados</h3>
              <p class="space-card-desc">O intervalo deixa de ser tempo morto e passa a ser ambiente projetado</p>
            </div>
          </div>

          <div class="space-card">
            <div>
              <div class="space-icon-box">
                <svg class="icon icon-lg" viewBox="0 0 24 24"><path d="M10 10v.2A3 3 0 0 1 8.9 16v0H5v0h0a3 3 0 0 1-1-5.8V10a3 3 0 0 1 6 0Z"/><path d="M7 16v6"/><path d="M13 19v3"/><path d="M12 19h8.3a1 1 0 0 0 .7-1.7L18 14h.3a1 1 0 0 0 .7-1.7L16 9h.2a1 1 0 0 0 .8-1.7L13 3l-4 4.3a1 1 0 0 0 .8 1.7H10l-3 3.3a1 1 0 0 0 .7 1.7H10l-3 3.3a1 1 0 0 0 .7 1.7H12"/></svg>
              </div>
              <h3 class="space-card-title">Natureza real</h3>
              <p class="space-card-desc">Cenário que existe — não construído para foto</p>
            </div>
          </div>
        </div>

        <div style="text-align: center;">
          <button type="button" class="btn btn-dark" data-open-modal>
            <span>Agendar visita técnica</span>
            <svg class="icon icon-sm" viewBox="0 0 24 24" style="stroke: #c3935b;"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- ==========================================================================
         8. FORMATOS DE EVENTO
         ========================================================================== -->
    <section id="formatos" class="section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Versatilidade Estrutural</span>
          <h2 class="section-title">Formatos de Evento</h2>
        </div>

        <div class="formats-grid">
          <!-- 1. Treinamentos -->
          <div class="format-card">
            <div class="format-img-box">
              <img loading="lazy" decoding="async" src="https://media.dmove.com.br/clients/villa-mantova/photos/corporativo/formato-treinamentos.webp" alt="Treinamentos e Workshops" class="format-img">
              <span class="format-badge">Sessões Simultâneas</span>
            </div>
            <div class="format-body">
              <div>
                <h3 class="format-title">Treinamentos e Workshops</h3>
                <p class="format-desc">Ambiente fora da rotina, com estrutura técnica que sustenta o dia inteiro</p>
              </div>
              <button type="button" class="format-action-btn" data-open-modal data-format="Treinamentos e Workshops">
                <span>Solicitar preview deste formato</span>
                <svg class="icon icon-sm" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </div>
          </div>

          <!-- 2. Congressos -->
          <div class="format-card">
            <div class="format-img-box">
              <img loading="lazy" decoding="async" src="https://media.dmove.com.br/clients/villa-mantova/photos/corporativo/formato-congressos.webp" alt="Congressos e Palestras" class="format-img">
              <span class="format-badge">Projeção e Som</span>
            </div>
            <div class="format-body">
              <div>
                <h3 class="format-title">Congressos e Palestras</h3>
                <p class="format-desc">Som, projeção e iluminação para apresentações de grande porte</p>
              </div>
              <button type="button" class="format-action-btn" data-open-modal data-format="Congressos e Palestras">
                <span>Solicitar preview deste formato</span>
                <svg class="icon icon-sm" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </div>
          </div>

          <!-- 3. Lançamentos -->
          <div class="format-card">
            <div class="format-img-box">
              <img loading="lazy" decoding="async" src="https://media.dmove.com.br/clients/villa-mantova/photos/corporativo/formato-lancamentos.webp" alt="Lançamentos de Produto" class="format-img">
              <span class="format-badge">Cenário Natural</span>
            </div>
            <div class="format-body">
              <div>
                <h3 class="format-title">Lançamentos de Produto</h3>
                <p class="format-desc">Cenário à altura do que a marca está apresentando</p>
              </div>
              <button type="button" class="format-action-btn" data-open-modal data-format="Lançamentos de Produto">
                <span>Solicitar preview deste formato</span>
                <svg class="icon icon-sm" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </div>
          </div>

          <!-- 4. Convenções -->
          <div class="format-card">
            <div class="format-img-box">
              <img loading="lazy" decoding="async" src="https://media.dmove.com.br/clients/villa-mantova/photos/corporativo/formato-convencoes.webp" alt="Convenções" class="format-img">
              <span class="format-badge">Multi-ambiente</span>
            </div>
            <div class="format-body">
              <div>
                <h3 class="format-title">Convenções</h3>
                <p class="format-desc">Capacidade para até 300 pessoas com sessões paralelas</p>
              </div>
              <button type="button" class="format-action-btn" data-open-modal data-format="Convenções">
                <span>Solicitar preview deste formato</span>
                <svg class="icon icon-sm" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </div>
          </div>

          <!-- 5. Confraternizações -->
          <div class="format-card">
            <div class="format-img-box">
              <img loading="lazy" decoding="async" src="https://media.dmove.com.br/clients/villa-mantova/photos/corporativo/formato-confraternizacoes.webp" alt="Confraternizações" class="format-img">
              <span class="format-badge">Até 300 pessoas</span>
            </div>
            <div class="format-body">
              <div>
                <h3 class="format-title">Confraternizações</h3>
                <p class="format-desc">Celebração de equipe em ambiente que muda de clima sem trocar de endereço</p>
              </div>
              <button type="button" class="format-action-btn" data-open-modal data-format="Confraternizações">
                <span>Solicitar preview deste formato</span>
                <svg class="icon icon-sm" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </div>
          </div>

          <!-- 6. Team Building -->
          <div class="format-card">
            <div class="format-img-box">
