---
// BIO do Instagram · Villa Mantova. Mesma identidade da LP /eventos-corporativos.
import Base from '../layouts/Base.astro';
import '../styles/bio.css';
import config from '../../config.json';
import { getPreset } from '../scripts/form-presets';

// A bio é geral (social + corporativo): usa o preset "corporativo" (empresa em 1º), mas o campo
// Empresa só aparece, e só é obrigatório, quando o tipo de evento escolhido é corporativo.
const campos = getPreset('corporativo');
const tiposCorporativos = [
  'Confraternizacao corporativa',
  'Corporativo',
  'Feiras e Exposicoes',
  'Masterclass e Palestras',
  'Mentorias e Treinamentos',
  'Offsite corporativo',
  'Reunioes de Networking',
  'Workshops, Conferencias e Seminarios',
];
const webhook = config.forms['lead-form'].webhooks[0];
const autoc: Record<string, string> = { nome: 'name', telefone: 'tel', email: 'email', empresa: 'organization' };
// Colunas estreitas no celular: placeholders mais curtos que os do preset
const placeholders: Record<string, string> = { nome: 'Seu nome', email: 'seu@email.com' };

const title = 'Villa Mantova | Links';
const description = 'Natureza e versatilidade para diferentes celebrações e eventos.';
const hero = 'https://media.dmove.com.br/clients/villa-mantova/photos/hero.webp';

const links = [
  {
    id: 'site',
    titulo: 'Site',
    subtitulo: 'villamantova.com.br',
    href: 'https://villamantova.com.br/',
    icone: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c2.500 2.400 3.800 5.400 3.800 9s-1.300 6.600-3.800 9c-2.500-2.400-3.800-5.400-3.800-9S9.500 5.400 12 3z',
  },
  {
    id: 'localizacao',
    titulo: 'Localização',
    subtitulo: 'R. Romênia, 21 - Maravilha lll, Santana de Parnaíba - SP, 06523-045',
    href: 'https://maps.app.goo.gl/2MNL6t9TZynSQgs67',
    icone: 'M12 21s7-6.200 7-11.500a7 7 0 0 0-14 0C5 14.800 12 21 12 21zM12 12.300a2.800 2.800 0 1 0 0-5.600 2.800 2.800 0 0 0 0 5.600z',
  },
];
---

<Base title={title} description={description} ogImage={hero} theme="light" hideWhatsApp={true}>
  <script is:inline slot="head">document.documentElement.classList.add('js');</script>
  <link rel="preload" as="image" href={hero} fetchpriority="high" slot="head" />
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500;6..96,600&family=Mulish:wght@300;400;600&display=swap" rel="stylesheet" slot="head" />

  <main class="bio">
    <figure class="bio__foto">
      <img src={hero} alt="Casa do Villa Mantova com varandas, jardim e céu azul" width="1537" height="1023" fetchpriority="high" />
    </figure>

    <div class="bio__conteudo">
      <span class="marca" role="img" aria-label="Villa Mantova"><b>VILLA MANTOVA</b></span>
      <h1>Natureza e versatilidade para diferentes celebrações e eventos.</h1>

      <ul class="bio__links">
        {links.map((l) => (
          <li>
            <a class="bio__link" href={l.href} target="_blank" rel="noopener" data-bio-link={l.id}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={l.icone} /></svg>
              <span class="bio__texto"><b>{l.titulo}</b><small>{l.subtitulo}</small></span>
            </a>
          </li>
        ))}
      </ul>

      <section class="bio__orcamento" id="orcamento-bio" aria-labelledby="orcamento-titulo">
        <h2 id="orcamento-titulo">Solicite orçamento</h2>
        <form class="bio__form" id="orcamento" data-form-id="villa-mantova-bio" data-fonte="Landing page/bio" data-submit-url={webhook} data-grid-id="orcamento" data-success-id="orcamento-sucesso" data-tipos-corporativos={JSON.stringify(tiposCorporativos)} novalidate>
          <input class="isca" type="text" name="website" aria-hidden="true" tabindex="-1" autocomplete="off" />
          {campos.map((c) => (
            <div class:list={['campo', c.full && 'campo--todo']} data-campo-empresa={c.name === 'empresa' ? '' : undefined} hidden={c.name === 'empresa'}>
              <label for={`form-field-${c.name}`}>{c.label}{c.hint && <span class="rotulo-hint"> ({c.hint})</span>}</label>
              {c.type === 'select' ? (
                <select id={`form-field-${c.name}`} name={c.name} required={c.required}>
                  {c.options?.map((o) => <option value={o.value} disabled={o.disabled} selected={o.selected}>{o.label}</option>)}
                </select>
              ) : c.type === 'textarea' ? (
                <textarea id={`form-field-${c.name}`} name={c.name} rows="3" required={c.required}></textarea>
              ) : (
                <input
                  id={`form-field-${c.name}`}
                  name={c.name}
                  type={c.type}
                  placeholder={placeholders[c.name] ?? c.placeholder}
                  required={c.required && c.name !== 'empresa'}
                  disabled={c.name === 'empresa'}
                  autocomplete={autoc[c.name]}
                  inputmode={c.type === 'tel' || c.type === 'number' ? 'numeric' : undefined}
                  min={c.type === 'number' ? '1' : undefined}
                  maxlength={c.datepicker ? 10 : undefined}
                  data-datepicker={c.datepicker ? '' : undefined}
                />
              )}
            </div>
          ))}
          <button class="botao form-submit" type="submit">Solicitar Orçamento</button>
          <p class="aviso" id="orcamentoFormMsg" role="status"></p>
        </form>
        <div class="sucesso" id="orcamento-sucesso" role="status">
          <h3>Recebemos sua solicitação</h3>
          <p>Em breve, nosso time entrará em contato com você.</p>
        </div>
        <p class="bio__privacidade">Usamos seus dados apenas para responder ao seu pedido de orçamento.</p>
      </section>
    </div>

    <footer class="bio__rodape">
      <p>© <span data-ano>2026</span> Villa Mantova. Todos os direitos reservados.</p>
      <p class="bio__credito">Desenvolvido por <a href="https://dmove.com.br" target="_blank" rel="noopener"><img src="/images/logo-dmove.webp" alt="Dmove" width="600" height="134" loading="lazy" /></a></p>
    </footer>
  </main>

  <script>
    import flatpickr from 'flatpickr';
    import { Portuguese } from 'flatpickr/dist/l10n/pt.js';
    import 'flatpickr/dist/flatpickr.min.css';
    import { initForms } from '../scripts/forms';

    initForms();

    // Empresa: só para tipos de evento corporativos (aparece, vira obrigatória e entra no envio)
    const formulario = document.querySelector<HTMLFormElement>('#orcamento');
    const tipoEvento = formulario?.querySelector<HTMLSelectElement>('[name="tipo_evento"]');
    const campoEmpresa = formulario?.querySelector<HTMLElement>('[data-campo-empresa]');
    const empresa = campoEmpresa?.querySelector<HTMLInputElement>('input');
    if (formulario && tipoEvento && campoEmpresa && empresa) {
      const corporativos: string[] = JSON.parse(formulario.dataset.tiposCorporativos || '[]');
      tipoEvento.addEventListener('change', () => {
        const corporativo = corporativos.includes(tipoEvento.value);
        campoEmpresa.hidden = !corporativo;
        empresa.disabled = !corporativo;
        empresa.required = corporativo;
        if (!corporativo) empresa.value = '';
      });
    }

    const data = document.querySelector<HTMLInputElement>('[data-datepicker]');
    if (data) {
      // máscara dd/mm/aaaa enquanto digita
      data.addEventListener('input', () => {
        const d = data.value.replace(/\D/g, '').slice(0, 8);
        data.value = d.length > 4 ? d.slice(0, 2) + '/' + d.slice(2, 4) + '/' + d.slice(4) : d.length > 2 ? d.slice(0, 2) + '/' + d.slice(2) : d;
      });
      flatpickr(data, { locale: Portuguese, dateFormat: 'd/m/Y', minDate: 'today', allowInput: true });
    }

    document.querySelectorAll('[data-ano]').forEach((el) => { el.textContent = String(new Date().getFullYear()); });
    // Clique nos botões da bio (fica no dataLayer para o GTM/GA4 quando houver container)
    document.querySelectorAll<HTMLAnchorElement>('[data-bio-link]').forEach((a) => {
      a.addEventListener('click', () => {
        (window as any).dataLayer?.push({ event: 'bio_click', link_location: a.dataset.bioLink, link_url: a.href });
      });
    });
  </script>
</Base>
