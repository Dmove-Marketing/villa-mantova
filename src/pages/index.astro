    <div class="section-head center reveal">
      <span class="eyebrow">Estrutura</span>
      <h2 class="title">Estrutura completa para receber e celebrar</h2>
    </div>
    <div class="estrutura-grid">
      <div class="estrutura-item reveal"><span class="estrutura-icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v3"/><path d="M2 11v5a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v2H6v-2a2 2 0 0 0-4 0Z"/><path d="M4 18v2"/><path d="M20 18v2"/></svg></span><p class="estrutura-nome">Mobiliário</p></div>
