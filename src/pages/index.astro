          <p>Encontros profissionais com estrutura e novas possibilidades</p>
          <a href="#agendar" class="btn btn-primary ev-cta" data-tipo="Corporativo">Solicite orçamento</a>
          <a href="/eventos-corporativos" class="ev-link">Conheça os eventos corporativos</a>
        </div>
      </div>
      <div class="event-card reveal">
        <div class="ev-img">
          <img loading="lazy" decoding="async" src="https://media.dmove.com.br/clients/villa-mantova/photos/home/debutantes.webp" width="1000" height="1500" alt="Debutante de vestido azul ao lado da mesa do bolo em festa no Villa Mantova" style="object-position:50% 22%">
          <div class="ev-num">03</div>
        </div>
        <div class="ev-content">
