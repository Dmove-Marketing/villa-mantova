---
// Réplica da home de villamantova.com.br (HTML/CSS/JS originais, imagens otimizadas em WebP).
// Home do projeto (rota "/"). A LP /eventos-corporativos e a /bio continuam como páginas próprias.
// CSS e JS: src/styles/institucional.css e src/scripts/institucional.js.
import Base from '../layouts/Base.astro';
import '../styles/institucional.css';
import config from '../../config.json';
import { getPreset } from '../scripts/form-presets';
import WhatsAppWidget from '../components/ui/WhatsAppWidget.astro';

// Formulário padrão Dmove da seção final ("Agendar visita"). A home é geral (casamentos, eventos sociais
// e corporativos): usa o preset "corporativo", mas o campo Empresa só aparece, e só é obrigatório,
// quando o tipo de evento escolhido é corporativo (mesma regra da /bio).
const campos = getPreset('corporativo');
// Webhook próprio da home (config.json > forms.site-form), usado pelo formulário e pelo popup de WhatsApp.
const webhook = config.forms['site-form'].webhooks[0];
const autoc: Record<string, string> = { nome: 'name', telefone: 'tel', email: 'email', empresa: 'organization' };
const tiposCorporativos = [
  'Confraternizacao corporativa',
  'Corporativo',
  'Feiras e Exposicoes',
  'Masterclass e Palestras',
  'Mentorias e Treinamentos',
  'Offsite corporativo',
  'Reunioes de Networking',
  'Workshops, Conferencias e Seminarios',
];

const title = 'Casamentos e Eventos em Alphaville | Villa Mantova';
const description = 'Espaço de campo a poucos minutos de Alphaville para casamentos, eventos corporativos e sociais. Natureza, ambientes independentes e estrutura completa.';
// OG precisa de URL absoluta; o domínio ainda não existe, então usa a imagem do CDN.
const ogImage = 'https://media.dmove.com.br/clients/villa-mantova/photos/hero.webp';
const hero = 'https://media.dmove.com.br/clients/villa-mantova/photos/home/hero.webp';

// FAQ: fonte única do HTML visível e do marcador FAQPage (o Google exige que os dois coincidam).
const faq = [
  { q: 'Qual é a capacidade máxima de convidados?', a: 'O Villa Mantova comporta de 50 a 300 convidados, com flexibilidade para diferentes formatos de evento.' },
  { q: 'Vocês oferecem pacotes personalizados?', a: 'Sim! Oferecemos opções personalizadas para diferentes tipos de eventos, considerando suas necessidades, preferências e orçamento.' },
  { q: 'Existe espaço para hospedagem de convidados?', a: 'Temos parcerias com hotéis e pousadas próximas. A localização em Alphaville facilita o acesso para convidados de São Paulo e região.' },
  { q: 'O que acontece se chover no dia do evento?', a: 'O Villa Mantova conta com uma estrutura coberta para acomodar o evento em caso de chuva, permitindo que a programação aconteça com tranquilidade.' },
];

// Dados estruturados. Sem `url` (domínio ainda não definido) e sem aggregateRating (a contagem de avaliações
// diverge entre as páginas: 390+ na home e 421 na LP); incluir quando houver fonte única.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', name: title, description, inLanguage: 'pt-BR' },
    {
      '@type': ['LocalBusiness', 'EventVenue'],
      name: 'Villa Mantova',
      description,
      image: ogImage,
      address: { '@type': 'PostalAddress', streetAddress: 'R. Romênia, 21 - Maravilha III', addressLocality: 'Santana de Parnaíba', addressRegion: 'SP', postalCode: '06523-045', addressCountry: 'BR' },
      geo: { '@type': 'GeoCoordinates', latitude: -23.4922037, longitude: -46.9997171 },
      hasMap: 'https://maps.app.goo.gl/2MNL6t9TZynSQgs67',
      sameAs: ['https://www.instagram.com/villa.mantova/'],
    },
    { '@type': 'FAQPage', mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ],
};
---

<!-- noIndex: réplica do site no ar; remova quando esta página for a oficial, para não duplicar conteúdo no Google -->
<Base title={title} description={description} ogImage={ogImage} theme="light" hideWhatsApp={true} noIndex={true} jsonLd={jsonLd}>
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Mulish:wght@400;500;600;700&display=swap" rel="stylesheet" slot="head" />
  <link rel="preload" as="image" href={hero} fetchpriority="high" slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />

<!-- ============================= HEADER ============================= -->
<header class="header" id="header">
  <div class="wrap nav">
    <a class="brand" href="#topo" aria-label="Villa Mantova">
      <img src="https://media.dmove.com.br/clients/villa-mantova/photos/institucional/logo-villa-mantova.png" alt="Villa Mantova">
    </a>
    <nav class="nav-links">
      <a href="#topo">Início</a>
      <a href="#sobre">Sobre</a>
      <a href="#espaco">Espaço</a>
      <a href="#eventos">Eventos</a>
      <a href="#galeria">Galeria</a>
      <a href="#depoimentos">Depoimentos</a>
      <a href="#faq">FAQ</a>
    </nav>
    <div class="nav-cta">
      <a href="https://www.instagram.com/villa.mantova/" target="_blank" rel="noopener noreferrer" class="instagram-circle-link" aria-label="Instagram">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>
      <a href="#agendar" class="btn btn-primary">Agendar visita <span class="arrow">→</span></a>
    </div>
    <button class="burger" id="burger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu">
  <a href="#topo">Início</a>
  <a href="#sobre">Sobre</a>
  <a href="#espaco">Espaço</a>
  <a href="#eventos">Eventos</a>
  <a href="#galeria">Galeria</a>
  <a href="#depoimentos">Depoimentos</a>
  <a href="#faq">FAQ</a>
  <a href="#agendar" class="btn btn-primary" style="color:#fff">Agendar visita →</a>
</div>

<!-- ============================= HERO ============================= -->
<section class="hero" id="topo" data-screen-label="Hero">
  <div class="hero-bg" style="background-image:url('https://media.dmove.com.br/clients/villa-mantova/photos/home/hero.webp')"></div>
  <div class="hero-shade"></div>
  <div class="wrap">
    <div class="hero-inner reveal">
      <h1 id="heroTitle">Um espaço para celebrar <em>grandes momentos</em></h1>
      <p class="hero-sub" id="heroSub">Natureza, estrutura e versatilidade para diferentes tipos de eventos</p>
      <p class="hero-tipos">Casamento • Eventos Corporativos • Eventos Sociais</p>
      <div class="hero-actions">
        <a href="#espaco" class="btn btn-primary" id="heroCta">Conheça o espaço <span class="arrow">→</span></a>
      </div>
    </div>
  </div>
  <a href="#sobre" class="scroll-hint"><span>Iniciar experiência</span><span class="line"></span></a>
</section>

<!-- ============================= AUTORIDADE ============================= -->
<section class="authority">
  <div class="wrap">
    <div class="stats stats--3">
      <div class="stat reveal"><div class="stat-num">500<span>+</span></div><div class="stat-label">Eventos realizados</div></div>
      <div class="stat reveal"><div class="stat-num"><small>Até</small> 300</div><div class="stat-label">Convidados</div></div>
      <div class="stat reveal"><div class="stat-num">4,9</div><div class="stat-label">Avaliação no Google</div></div>
    </div>
  </div>
</section>

<!-- ============================= SOBRE ============================= -->
<section class="section sobre" id="sobre">
  <div class="wrap">
    <div class="story-grid">
      <div class="story-copy reveal">
        <span class="eyebrow">Sobre</span>
        <h2 class="title">A combinação ideal entre natureza e praticidade</h2>
        <p style="margin-top:28px">O Villa Mantova nasceu da vontade de oferecer um espaço de campo com a conveniência de quem precisa de estrutura. A poucos minutos de Alphaville e perto da Rodovia Castelo Branco, reunimos natureza, ambientes independentes e uma equipe que cuida do evento do planejamento ao encerramento.</p>
        <div class="sobre-pontos">
          <div class="sobre-ponto">Eventos corporativos e sociais</div>
          <div class="sobre-ponto">Solução 360°</div>
          <div class="sobre-ponto">Integração com a natureza</div>
        </div>
      </div>
      <div class="story-media reveal">
        <div class="img-main"><img loading="lazy" decoding="async" src="https://media.dmove.com.br/clients/villa-mantova/photos/home/sobre.webp" width="1280" height="853" alt="Área coberta e gramado do Villa Mantova com a natureza ao redor"></div>
      </div>
    </div>
  </div>
</section>

<!-- ============================= ESPAÇO ============================= -->
<section class="section espaco" id="espaco">
  <div class="wrap">
    <div class="section-head center reveal">
      <span class="eyebrow">O Espaço</span>
      <h2 class="title">Ambientes versáteis para diferentes momentos</h2>
    </div>
    <div class="space-grid space-grid--5">
      <div class="space-card reveal">
        <div class="card-img"><img loading="lazy" decoding="async" src="https://media.dmove.com.br/clients/villa-mantova/photos/home/casa-de-apoio.webp" width="1600" height="1066" alt="Casa de apoio do Villa Mantova com mesas montadas no gramado e cordão de luzes"></div>
        <div class="card-body">
          <div class="card-rule"></div>
          <h3>Casa de Apoio</h3>
          <p>Ambiente reservado para os preparativos dos noivos e como camarim e apoio para palestrantes e equipes.</p>
        </div>
      </div>
      <div class="space-card reveal">
        <div class="card-img"><img loading="lazy" decoding="async" src="https://media.dmove.com.br/clients/villa-mantova/photos/home/area-externa.webp" width="1600" height="1067" alt="Área externa do Villa Mantova com cerimônia montada ao ar livre, bancos de madeira e flores brancas"></div>
        <div class="card-body">
          <div class="card-rule"></div>
          <h3>Área externa</h3>
          <p>Espaço para cerimônias ao ar livre e eventos em contato com a natureza.</p>
        </div>
      </div>
      <div class="space-card reveal">
        <div class="card-img"><img loading="lazy" decoding="async" src="https://media.dmove.com.br/clients/villa-mantova/photos/home/area-coberta.webp" width="1600" height="1194" alt="Área coberta do Villa Mantova com mesas longas montadas para um evento corporativo"></div>
        <div class="card-body">
          <div class="card-rule"></div>
          <h3>Área coberta</h3>
          <p>Ambiente versátil para receber convidados, coffee breaks e momentos de convivência.</p>
        </div>
      </div>
      <div class="space-card reveal">
        <div class="card-img"><img loading="lazy" decoding="async" src="https://media.dmove.com.br/clients/villa-mantova/photos/home/lounge.webp" width="1440" height="957" alt="Lounge ao ar livre do Villa Mantova com sofá e poltronas sob as árvores"></div>
        <div class="card-body">
          <div class="card-rule"></div>
          <h3>Lounge</h3>
          <p>Espaço acolhedor ao ar livre, ideal para pausas, conversas e momentos de descontração.</p>
        </div>
      </div>
      <div class="space-card reveal">
        <div class="card-img"><img loading="lazy" decoding="async" src="https://media.dmove.com.br/clients/villa-mantova/photos/home/piscina.webp" width="1600" height="1067" alt="Piscina do Villa Mantova cercada por deque de madeira e jardim"></div>
        <div class="card-body">
          <div class="card-rule"></div>
          <h3>Piscina</h3>
          <p>Um espaço que amplia as possibilidades de uso e proporciona momentos de convivência ao ar livre.</p>
        </div>
      </div>
    </div>
  </div>
</section>

