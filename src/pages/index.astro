    </div>
  </div>
</section>

<!-- ============================= GOOGLE REVIEWS ============================= -->
<section class="section" id="depoimentos">
  <div class="wrap">
    <div class="section-head center reveal">
      <span class="eyebrow">Depoimentos</span>
      <h2 class="title">A experiência de quem já celebrou no Villa Mantova</h2>
    </div>
    <div class="reviews-grid">
      <div class="gscore reveal">
