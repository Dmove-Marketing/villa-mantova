      </div>
      <div class="event-card reveal">
        <div class="ev-img">
          <img loading="lazy" decoding="async" src="https://media.dmove.com.br/clients/villa-mantova/photos/home/corporativos.webp" width="1376" height="768" alt="Apresentação em evento corporativo ao ar livre no Villa Mantova, com plateia e telão">
          <div class="ev-num">02</div>
        </div>
        <div class="ev-content">
